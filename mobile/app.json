{
  "expo": {
    "name": "Inventario",
    "slug": "inventario-equipo-lot",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "android": {
      "usesCleartextTraffic": true
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite elegir fotos de los componentes.",
          "cameraPermission": "Permite tomar fotos de los componentes."
        }
      ]
    ]
  }
}
